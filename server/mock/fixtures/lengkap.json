            {
              "type": "faq",
              "data": {
                "heading": "Pertanyaan Umum",
                "items": [
                  {
                    "question": "Berapa lama proses desain?",
                    "answer": "Desain konsep 2–3 minggu, gambar kerja lengkap 4–6 minggu tergantung skala proyek."
                  },
                  {
                    "question": "Apakah melayani luar Jakarta?",
                    "answer": "Ya, kami melayani seluruh Jabodetabek dan kota besar lain dengan penyesuaian biaya mobilisasi."
                  },
                  {
                    "question": "Bagaimana skema pembayaran?",
                    "answer": "Bertahap mengikuti progres: DP 20%, lalu termin sesuai milestone yang disepakati di kontrak."
                  },
                  {
                    "question": "Bisa desain saja tanpa bangun?",
                    "answer": "Bisa. Paket desain berdiri sendiri dan gambar kerja bisa dipakai kontraktor mana pun."
                  }
                ]
              }
            }
          ]
