{
  // Project TS untuk unit test vitest (di luar graph .nuxt/*) — mencakup
  // modul murni yang diuji: server/utils/tenant-host, server/mock/*.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // dashboard-palette.spec memakai fitur Vite (`?raw`, import.meta.glob)
    // untuk membaca main.css + memindai komponen tanpa perlu @types/node.
    "types": ["vite/client"]
  },
  "include": [
    "./**/*.ts",
    "../app/utils/*.ts",
    "../server/utils/tenant-host.ts",
    "../server/utils/render-cache-key.ts",
    "../server/mock/**/*.ts",
    "../shared/**/*.ts"
  ]
}
